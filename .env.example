# Database
DATABASE_URL="postgresql://user:password@localhost:5432/whitelayer_db"

# Authentication & Sessions
JWT_SECRET="your_secure_random_jwt_secret_min_32_chars"
COOKIE_NAME="whitelayer_session"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payment Gateway (Razorpay Sandbox/Production)
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_signing_secret"

# Store Configuration
NEXT_PUBLIC_STORE_NAME="flirta.network"
NEXT_PUBLIC_STORE_CURRENCY="INR"
NEXT_PUBLIC_STORE_CURRENCY_SYMBOL="₹"

# PayU India Gateway Configuration (Live / Test)
PAYU_MERCHANT_KEY="your_payu_merchant_key"
PAYU_MERCHANT_SALT="your_payu_merchant_salt"
PAYU_CLIENT_ID="your_payu_client_id"
PAYU_CLIENT_SECRET="your_payu_client_secret"
PAYU_MID="your_payu_mid"
PAYU_ENV="prod" # or 'test'
